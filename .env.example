# =============================================================================
#  Konfiguracja projektu
# =============================================================================
#  1. Skopiuj ten plik:   cp .env.example .env
#  2. Zmień ADMIN_PASSWORD (resztę możesz zostawić).
#  3. Gotowe. Plik .env jest w .gitignore, więc nie wrzucaj go do repo.
#
#  Każda zmienna ma wartość domyślną albo jest opcjonalna. Jak nie wiesz,
#  co wpisać, zostaw tak, jak jest.
# =============================================================================


# -----------------------------------------------------------------------------
#  Porty na Twoim komputerze  (Docker: docker compose up)
# -----------------------------------------------------------------------------
#  Zmień tylko wtedy, gdy port jest już zajęty przez inny program.

# Strona aplikacji:  http://localhost:8090
FRONTEND_PORT=8090

# Podgląd bazy danych w przeglądarce (tylko odczyt, tylko z tego komputera):
# http://localhost:8091
SQLITE_WEB_PORT=8091


# -----------------------------------------------------------------------------
#  Backend (aplikacja w Javie)
# -----------------------------------------------------------------------------

# Pierwsze konto administratora. Tworzy się tylko przy pustej bazie
# (pierwsze uruchomienie). Potem zmiana tych wartości nic nie robi.
#  - ustaw OBA albo ŻADNE (jedno bez drugiego = backend nie wystartuje)
#  - hasło: minimum 12 znaków
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=zmien-mnie-na-dlugie-haslo

# true  = przy starcie wgraj przykładowe kategorie, rodzaje i usługi
# false = pusta baza
DANE_TESTOWE=true

# Sekret do podpisu tokenów logowania (JWT), minimum 32 znaki.
# Wygeneruj:  openssl rand -base64 48
# Bez tego backend losuje sekret przy każdym starcie, więc po restarcie
# wszyscy muszą zalogować się ponownie (lokalnie to nie problem).
# JWT_SECRET=


# -----------------------------------------------------------------------------
#  Docker Hub  - potrzebne tylko do: make push (wypchnięcie obrazów na serwer)
# -----------------------------------------------------------------------------
#  Obrazy nazywają się <DOCKERHUB_USER>/techfix-backend:<IMAGE_TAG>
#  i <DOCKERHUB_USER>/techfix-frontend:<IMAGE_TAG>.
#  Bez ustawienia zostaje "local", czyli obrazy tylko na tym komputerze.

# DOCKERHUB_USER=twoj-login-na-docker-hub
# IMAGE_TAG=latest


# -----------------------------------------------------------------------------
#  Tryb developerski (bez Dockera)  - potrzebne tylko do: npm run dev
# -----------------------------------------------------------------------------
#  Frontend (Vite) startuje na FRONTEND_DEV_PORT i przekazuje zapytania
#  do backendu (wszystko spod /api) uruchomionego na Tomcacie.
#
#  UWAGA: Tomcat uruchomiony z IDE NIE czyta tego pliku. ADMIN_EMAIL,
#  ADMIN_PASSWORD i DANE_TESTOWE ustaw w konfiguracji uruchomieniowej
#  (Run Configuration -> Environment variables).

# Port serwera Vite:  http://localhost:5173
FRONTEND_DEV_PORT=5173

# Port, na którym działa Twój lokalny Tomcat
BACKEND_DEV_PORT=8080

# Opcjonalnie: pełny adres backendu, gdy nie jest na localhost.
# Jeśli ustawione, ma pierwszeństwo przed BACKEND_DEV_PORT.
# BACKEND_URL=http://localhost:8080
