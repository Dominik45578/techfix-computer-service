# =============================================================================
#  TechFix: konfiguracja serwera
# =============================================================================
#  Skopiuj obok docker-compose.yml jako .env i uzupełnij.
#  Zmienne bez wartości domyślnej są wymagane: bez nich compose nie wystartuje.
# =============================================================================


# --- Obrazy ------------------------------------------------------------------

# Login na Docker Hubie, pod którym są obrazy techfix-backend i techfix-frontend.
DOCKERHUB_USER=

# Wersja obrazów (tag wypchnięty przez `make push IMAGE_TAG=...`).
IMAGE_TAG=latest


# --- Porty -------------------------------------------------------------------

# Port aplikacji na serwerze. 80 = http://adres-serwera
FRONTEND_PORT=80

# Podgląd bazy, dostępny tylko z serwera (albo przez tunel SSH).
SQLITE_WEB_PORT=8091


# --- Backend -----------------------------------------------------------------

# Pierwsze konto administratora, tworzone tylko przy pustej bazie.
# Hasło: minimum 12 znaków. Ustaw własne, nie zostawiaj przykładu!
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Przykładowe dane w bazie. Na produkcji zwykle false.
DANE_TESTOWE=false
